<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:chat="using:ChatSystem.Client.Core.Domain.Chat"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChatSystem.Client.Presentation.ViewModels"
             x:Class="ChatSystem.Client.Presentation.Views.ChatListView"
             x:DataType="vm:ChatListViewModel"
             x:CompileBindings="True">

    <ListBox ItemsSource="{Binding Chats}"
             SelectedItem="{Binding SelectedChat}"
             Background="Transparent"
             BorderThickness="0">

             <ListBox.ItemTemplate>
                 <DataTemplate x:DataType="vm:DirectMessageChatListItemViewModel">
                     <Border Padding="12,8" CornerRadius="6">
                        <TextBlock Text="{Binding DisplayName}"
                                FontWeight="SemiBold" 
                                FontSize="15"
                                TextTrimming="CharacterEllipsis"/>
                     </Border>
                 </DataTemplate>
             </ListBox.ItemTemplate>
    </ListBox>

</UserControl>